{
  "name": "@rzmps/rapier",
  "version": "1.0.2",
  "description": "Rapier physics engine extension for rzmps.",
  "main": "build/index.cjs",
  "module": "build/index.mjs",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "rzmps",
    "three",
    "threejs",
    "particles",
    "particle-system",
    "physics",
    "collision",
    "rapier",
    "rapier3d",
    "typescript"
  ],
  "files": [
    "build/**/*"
  ],
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "dev": "concurrently -k \"tsdown --watch\" \"tsc --emitDeclarationOnly --watch\"",
    "prepack": "npm run build"
  },
  "tsdown": {
    "entry": [
      "src/index.ts"
    ],
    "outDir": "build",
    "format": [
      "esm",
      "cjs"
    ],
    "dts": false,
    "platform": "neutral",
    "fixedExtension": true,
    "target": "es2015"
  },
  "author": "Robert May",
  "license": "MIT",
  "peerDependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@rzmps/rzmps": "^1.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@rzmps/rzmps": "^1.0.0",
    "concurrently": "^6.1.0",
    "three": "^0.185.1",
    "typescript": "^5.0.0"
  }
}
