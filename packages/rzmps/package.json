{
  "name": "@rzmps/rzmps",
  "version": "2.0.0",
  "description": "\ud83e\uddc5 Modular and extendable particle system for Three.js",
  "homepage": "https://github.com/rzmay/rzmps#readme",
  "bugs": {
    "url": "https://github.com/rzmay/rzmps/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rzmay/rzmps.git",
    "directory": "packages/rzmps"
  },
  "main": "build/index.cjs",
  "module": "build/index.mjs",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    },
    "./Emitter": {
      "types": "./build/emission/Emitter.d.ts"
    },
    "./ParticleSystem": {
      "types": "./build/core/ParticleSystem.d.ts"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "three",
    "threejs",
    "particles",
    "particle-system",
    "webgl",
    "webgpu",
    "vfx",
    "simulation",
    "typescript"
  ],
  "files": [
    "build/**/*",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../apps/docs/scripts/package-agents.mjs && tsdown && tsc --emitDeclarationOnly && npm run copy:static && npm run copy:declarations",
    "copy:assets": "npm run copy:static",
    "copy:static": "mkdir -p build && cp src/global.d.ts build/global.d.ts && rm -rf build/assets && cp -r src/assets build/assets",
    "copy:declarations": "if [ -f build/index.d.ts ]; then cp build/index.d.ts build/index.d.mts && cp build/index.d.ts build/index.d.cts; else echo \"Skipping declaration aliases; build/index.d.ts has not been emitted yet.\"; fi",
    "dev": "concurrently -k \"tsdown --watch --no-clean\" \"tsc --emitDeclarationOnly --watch\" \"watch 'npm run copy:static' src/assets\"",
    "test": "node ../../tests/run.mjs --workspace packages/rzmps",
    "prepack": "npm run build"
  },
  "author": "Robert May",
  "license": "MIT",
  "dependencies": {
    "fast-simplex-noise": "^4.0.0",
    "nanoid": "^3.1.23",
    "seedrandom": "^3.0.5"
  },
  "peerDependencies": {
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@types/seedrandom": "^3.0.8",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "concurrently": "^6.1.0",
    "eslint": "~8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.16",
    "typescript": "5.9",
    "watch": "^0.13.0"
  }
}
