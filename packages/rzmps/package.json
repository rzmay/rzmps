{
  "name": "@rzmps/rzmps",
  "version": "1.2.0",
  "description": "🧅 Modular and extendable particle system for Three.js",
  "main": "build/index.cjs",
  "module": "build/index.mjs",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "three",
    "threejs",
    "particles",
    "particle-system",
    "webgl",
    "webgpu",
    "vfx",
    "simulation",
    "typescript"
  ],
  "files": [
    "build/**/*"
  ],
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly && npm run copy:assets",
    "build:shaders": "node scripts/build-shaders.mjs",
    "copy:assets": "mkdir -p build && rm -rf build/assets && cp -r src/assets build/assets",
    "fix:shader-imports": "node scripts/fix-shader-imports.mjs",
    "dev": "concurrently -k \"tsdown --watch\" \"tsc --emitDeclarationOnly --watch\" \"watch 'npm run copy:assets' src/assets\"",
    "prepack": "npm run build"
  },
  "tsdown": {
    "entry": [
      "src/index.ts"
    ],
    "outDir": "build",
    "format": [
      "esm",
      "cjs"
    ],
    "dts": false,
    "platform": "neutral",
    "fixedExtension": true,
    "target": "es2015",
    "loader": {
      ".frag": "text",
      ".vert": "text",
      ".png": "dataurl",
      ".jpg": "dataurl",
      ".jpeg": "dataurl"
    }
  },
  "author": "Robert May",
  "license": "MIT",
  "dependencies": {
    "fast-simplex-noise": "^4.0.0",
    "nanoid": "^3.1.23",
    "seedrandom": "^3.0.5"
  },
  "peerDependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/seedrandom": "^3.0.8",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^4.23.0",
    "concurrently": "^6.1.0",
    "eslint": "^7.26.0",
    "eslint-config-airbnb": "^18.2.1",
    "three": "^0.185.1",
    "typescript": "5.9",
    "watch": "^0.13.0"
  }
}
