{
  "name": "RZMPS Monorepo",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace @rzmps/rzmps\" \"npm start --workspace demo\"",
    "test": "npm test --workspace @rzmps/rzmps",
    "build:modules": "npm run build --workspace @rzmps/rzmps && npm run build --workspace @rzmps/ammo && npm run build --workspace @rzmps/jolt && npm run build --workspace @rzmps/rapier",
    "benchmark:run": "npm --workspace demo run benchmark:run --",
    "benchmark:update-report": "node scripts/update-benchmark-report.mjs",
    "benchmark:export": "node scripts/update-benchmark-report.mjs --json-only",
    "benchmark:compare": "node scripts/compare-benchmarks.mjs",
    "presets:add-author": "node scripts/add-preset-author.mjs"
  },
  "devDependencies": {
    "tsdown": "^0.23.0"
  },
  "overrides": {
    "three": "0.186.0"
  }
}
