{
  "name": "RZMPS Monorepo",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples",
    "scripts",
    "tests",
    "benchmarks"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @rzmps/scripts",
    "build": "npm run build:packages --workspace @rzmps/scripts",
    "test": "node tests/run.mjs",
    "lint": "npm run lint --workspace @rzmps/scripts",
    "scripts": "node scripts/run.mjs",
    "benchmarks": "node benchmarks/run.mjs",
    "preview": "node scripts/preview/capture.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.71.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "~10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "skills": "^1.8.1",
    "tsdown": "^0.23.7",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "7.0",
    "unrun": "^0.3.1",
    "vitepress": "^1.6.4",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "three": "0.186.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0"
}
